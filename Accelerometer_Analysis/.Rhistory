# UMAP --------------------------------------------------------------------
# Simplifies the data based on its relationship to its numbers
# Set the minimum distance between reach points
minimum_distance = 0.1
# How many neighbours can influence the decision of an individual point.
num_neighbours = 10
# The mathematical means of measuring the relationship between two points.
shape_metric = 'cosine'
# Spread
spread = 1
numeric_features <- filtered_feature_data %>%
select(-c("Time", "ID", "Activity")) %>%
mutate(across(everything(), as.numeric))
pdf(file = file.path(base_path, "Plots", "UMAPExample1.pdf"),
width = 16, # The width of the plot in inches
height = 8)
