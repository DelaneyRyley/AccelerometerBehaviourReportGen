removeBadFeatures <- function(feature_data, variance_threshold, na_threshold) {
# Step 1: Calculate variance for numeric columns
numeric_columns <- feature_data[, .SD, .SDcols = !c("Activity", "Time", "ID", "GeneralisedActivity", "OtherActivity")]
variances <- numeric_columns[, lapply(.SD, var, na.rm = TRUE)]
selected_columns <- names(variances)[!is.na(variances) & variances > variance_threshold]
numeric_columns <- numeric_columns[, ..selected_columns]
valid_columns <- colSums(is.na(numeric_columns)) / nrow(numeric_columns) <= na_threshold
numeric_columns <- numeric_columns[, ..valid_columns]
# Step 2: Remove highly correlated features
corr_matrix <- cor(numeric_columns, use = "pairwise.complete.obs")
high_corr <- findCorrelation(corr_matrix, cutoff = 0.9)
remaining_features <- setdiff(names(numeric_columns), names(numeric_columns)[high_corr])
return(remaining_features)
}
